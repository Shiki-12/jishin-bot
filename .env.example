# Token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API untuk LLM (format OpenAI: POST {LLM_BASE_URL}/chat/completions)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.xkiro.com/v1
LLM_MODEL=mistralai/mistral-large-2512
LLM_FALLBACK_MODEL=qwen/qwen3.7-flash:free
# Model khusus untuk input gambar/vision (opsional, kosong = memakai LLM_MODEL)
LLM_VISION_MODEL=

# Fitur Audio / Voice (F-31)
# Model Text-to-Speech (TTS) di gateway (default: xkiro-voice)
TTS_MODEL=xkiro-voice
# Model Speech-to-Text (STT) di gateway (default: whisper-1)
STT_MODEL=whisper-1

# Opsional: API key Giphy untuk fitur kirim GIF (https://developers.giphy.com)
# Kalau dikosongkan, bot tetap jalan tapi tidak kirim GIF.
GIPHY_API_KEY=

# Personality yang dipakai (lihat src/personalities/: tsundere, kalem, ceria, sarkas, custom)
PERSONALITY=tsundere

# Jumlah pesan terakhir yang diingat per chat
MAX_HISTORY=24

# Modul fitur yang aktif (pisahkan koma atau 'all' untuk semua).
# Fitur inti (start, help, forget, about, settings) selalu aktif dan tidak perlu ditulis.
# Fitur yang tidak aktif tidak akan muncul di menu Telegram '/', /help, prompt LLM, maupun background task.
# Perintah admin hanya aktif jika modul 'admin' ada di FEATURES.
# Contoh: FEATURES=all
# Contoh: FEATURES=reminders,todo,notes,weather,admin
FEATURES=all

# Penjaga & Keamanan (F-04 & Hak Akses Admin)
# Daftar user ID Telegram admin bot (pisahkan koma, contoh: 123456789,987654321).
# Perintah admin (/stats, /ban, /unban, /broadcast, /model, /maintenance, /addsticker, /delsticker)
# disembunyikan dari menu publik dan hanya didaftarkan khusus ke user ID di sini.
# Catatan: Admin harus mengirim /start ke bot minimal sekali agar menu chat admin muncul di Telegram.
ADMIN_IDS=
# Whitelist user Telegram yang boleh akses (kosongkan = semua diizinkan)
ALLOWED_USER_IDS=
# Batas rate limit panggilan LLM per menit per user
RATE_LIMIT_PER_MINUTE=8
# Batas rate limit panggilan LLM per hari per user (0 = tanpa batas harian)
RATE_LIMIT_PER_DAY=0
# Batas panjang karakter pesan masuk
MAX_INPUT_LENGTH=2000
# Batas antrian pemrosesan pesan per chat
MAX_QUEUE_PER_CHAT=5

# Server HTTP, Health Check, & Webhook (F-62)
# Port HTTP server untuk monitoring health check / webhook (default: 3000)
PORT=3000
# Opsional: URL publik Webhook Telegram (misal: https://bot.example.com/webhook)
# Kosongkan untuk menggunakan mode Long Polling bawaan.
WEBHOOK_URL=
# Opsional: Rahasia token webhook Telegram
WEBHOOK_SECRET=

# Logging & Pemakaian Token (F-64)
# Tingkat logging aplikasi: debug, info, warn, error, none (default: info)
LOG_LEVEL=info
# Batas peringatan token harian per user (0 = tanpa batas/peringatan)
DAILY_TOKEN_LIMIT=0

